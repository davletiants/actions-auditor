{
  "name": "actions-auditor",
  "version": "0.1.0",
  "description": "GitHub Action that blocks PRs adding GitHub Actions not pinned to a full commit SHA, and suggests the fix.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "all": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^5.9.3"
  }
}
